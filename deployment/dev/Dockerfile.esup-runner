# Image de base avec uv
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    git make curl ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Clonage automatique du projet esup-runner
RUN git clone https://github.com/EsupPortail/esup-runner.git .

# --- Stage Manager ---
FROM base AS manager
WORKDIR /app/manager
RUN cp .env.example .env && make sync-dev && make init
EXPOSE 8081
CMD ["make", "run"]

# --- Stage Runner ---
FROM base AS runner
WORKDIR /app/runner
RUN cp .env.example .env && \
    # On configure le runner pour qu'il trouve le manager sur le réseau docker
    sed -i 's/MANAGER_HOST=0.0.0.0/MANAGER_HOST=manager/g' .env && \
    sed -i 's/127.0.0.1:8000/manager:8081/g' .env || true && \
    make sync-transcription-cpu && make sync-dev && make init
CMD ["make", "run"]