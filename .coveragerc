[run]
source = src
omit =
    */migrations/*
    */tests/*
    */__init__.py
    manage.py
    src/config/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG:
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
