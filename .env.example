# --- Django Core ---
DJANGO_SETTINGS_MODULE=config.django.dev.docker
SECRET_KEY=change-me-in-production-please-make-it-long-and-random
VERSION=5.0.0-DEV
EXPOSITION_PORT=8000

API_PAGE_SIZE=20

# --- Database ---
MYSQL_DATABASE=pod_db
MYSQL_USER=pod_user
MYSQL_PASSWORD=pod_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Initial Admin User ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=admin

# --- Docker Container User (UID/GID) ---
# To avoid permission issues when files are created by the container on the host.
# If you run docker compose directly (without make), set these to your host user's UID and GID.
# You can find your UID/GID by running `id -u` and `id -g` on the host.
# USER_UID=1000
# USER_GID=1000

# --- Authentication Secrets & Endpoints ---
#
# Security / Admin Access
# List of IPs and/or CIDR ranges from which Django admin 'superuser' status is allowed.
# Leave it empty (e.g. ALLOWED_SUPERUSER_IPS="") to completely disable the IP restriction (e.g. in development/preprod).
ALLOWED_SUPERUSER_IPS='[""]'
#
# CAS
# CAS_SERVER_URL="https://cas.example.org/cas"
# CAS_VERSION="3"
#
# LDAP
# LDAP_SERVER_URL="ldaps://ldap.example.org"
# LDAP_SERVER_PORT=636
# LDAP_SERVER_USE_SSL=true
# LDAP_BIND_DN="cn=admin,dc=example,dc=org"
# LDAP_BIND_PASSWORD="my-secret-ldap-password"
# LDAP_USER_SEARCH_BASE="ou=people,dc=example,dc=org"
#
# OIDC
# OIDC_RP_CLIENT_ID="my-oidc-client-id"
# OIDC_RP_CLIENT_SECRET="my-oidc-client-secret"
# OIDC_OP_TOKEN_ENDPOINT="https://oidc.example.org/token"
# OIDC_OP_USER_ENDPOINT="https://oidc.example.org/userinfo"


REDIS_PORT=6379
REDIS_PASSWORD=

# --- Storage / Media ---
# Path to the media directory. By default, it's a local directory.
# For NFS mounts or external storage, mount it on the host and specify the path here.
# e.g., MEDIA_PATH=/srv/pod
# MEDIA_PATH=../../media

# --- Celery and Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_SESSION_URL=redis://redis:6379/2

# --- ESUP Runner Integration ---
# AUTHORIZED_TOKENS__RUNNER_DEV is used to authorize local runner instances
AUTHORIZED_TOKENS__RUNNER_DEV=my-super-token-123

# The token used by POD to authenticate with the ESUP Runner Manager
RUNNER_TOKEN=my-super-token-123
RUNNER_BASE_PORT=8082
RUNNER_TASK_TYPES=encoding,studio

# Comma-separated list of hosts/IPs allowed to receive webhooks from the runner.
# 'api' is the default service name in docker-compose.
NOTIFY_URL_ALLOWED_HOSTS=localhost,api,api:8000,pod-api,pod-api:8000

ENCODING_WEBHOOK_SECRET=my_secret_webhook_123
# The internal or external URL of the ESUP Runner Manager
ENCODING_MANAGER_URL=http://esup-runner-manager:8081
ENCODING_MANAGER_TOKEN=my-super-token-123

# The base URL of the POD API. Use http://localhost:8000 for local dev
# or the service name 'http://api:8000' if running inside a Docker network.
SITE_URL=http://localhost:8000

# --- Encoding Customization ---
# Default: mp4,avi,mov,mkv,flv,webm,m4v,m2ts,mts,ts,mpg,ogg,mp3
POD_ENCODING_ALLOWED_EXTENSIONS=mp4,avi,mov,mkv,flv,webm,m4v,m2ts,mts,ts,mpg,ogg,mp3

# --- API Testing Scripts (test_api_curl.sh) ---
API_TEST_USER_LOGIN=admin
API_TEST_USER_PASS=admin
API_TEST_VIDEO_PASS=ci_secret_123
