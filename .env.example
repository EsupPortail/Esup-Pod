# --- Django Core ---
DJANGO_SETTINGS_MODULE=config.django.dev.docker
SECRET_KEY=change-me-in-production-please-make-it-long-and-random
VERSION=5.0.0-DEV
EXPOSITION_PORT=8000

# --- Database ---
MYSQL_DATABASE=pod_db
MYSQL_USER=pod_user
MYSQL_PASSWORD=pod_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Initial Admin User ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# --- Authentication Secrets & Endpoints ---
# ALLOWED_SUPERUSER_IPS="127.0.0.1"
# CAS_SERVER_URL="https://cas.univ.fr/cas"
#
# LDAP_SERVER_URL="ldaps://ldap.univ.fr"
# LDAP_SERVER_PORT=636
# LDAP_BIND_DN="cn=admin,dc=univ,dc=fr"
# LDAP_BIND_PASSWORD="my-secret-ldap-password"
# OIDC_RP_CLIENT_ID="my-oidc-client-id"
# OIDC_RP_CLIENT_SECRET="my-oidc-client-secret"
# OIDC_OP_TOKEN_ENDPOINT="https://oidc.univ.fr/token"
# OIDC_OP_USER_ENDPOINT="https://oidc.univ.fr/userinfo"

# --- Celery and Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Encoding Manager API ---
ENCODING_MANAGER_URL=http://localhost:8081
ENCODING_MANAGER_TOKEN=test_token